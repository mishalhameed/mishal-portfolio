# Public site origin for canonical URLs and the sitemap.
# Example: https://yourdomain.com
VITE_SITE_URL=

# Optional analytics. Leave blank to disable. Events still dispatch locally as `mh:analytics`.
VITE_PLAUSIBLE_DOMAIN=

# Email delivery. Use Resend, or a webhook, or neither.
# If none are set, the form validates and explains that delivery is not connected.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
CONTACT_WEBHOOK_URL=
